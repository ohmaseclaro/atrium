# Copy to `deploy/atrium-demo.env` on the server (never commit secrets).
# systemd reads this via `EnvironmentFile=` in `atrium-demo.service`.

NODE_ENV=production
PORT=7341

# Worker the demo API dials (must be reachable from this host).
ATRIUM_WORKER_DIAL_BASE=ws://127.0.0.1:7070
ATRIUM_WORKER_SECRET=change-me

# Optional: same as demo defaults if unset
# ATRIUM_WORKER_TLS_INSECURE=0

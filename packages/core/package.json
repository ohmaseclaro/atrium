{
  "name": "@atriumjs/core",
  "version": "0.2.0",
  "description": "Framework-agnostic Atrium core (Web Fetch handlers, session store, transports)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohmaseclaro/atrium.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ohmaseclaro/atrium/issues"
  },
  "homepage": "https://github.com/ohmaseclaro/atrium/tree/main/packages/core#readme",
  "keywords": [
    "atrium",
    "remote-browser",
    "fetch"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./policies": {
      "types": "./dist/policies-demo.d.ts",
      "import": "./dist/policies-demo.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@atriumjs/protocol": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}

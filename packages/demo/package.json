{
  "name": "@ohmaseclaro/atrium-demo",
  "private": true,
  "version": "0.0.0",
  "description": "Full-stack demo: @ohmaseclaro/atrium-server + @ohmaseclaro/atrium-react + defaults (worker on 7070)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "pnpm --filter @ohmaseclaro/atrium-worker start",
    "dev:web": "node scripts/wait-for-worker.mjs && tsx server/dev-server.ts",
    "dev:ui-only": "tsx server/dev-server.ts",
    "build": "vite build && tsc -p server/tsconfig.json --pretty false",
    "start": "NODE_ENV=production node dist/server/prod-server.js",
    "lint": "pnpm run typecheck",
    "typecheck": "pnpm --filter @ohmaseclaro/atrium-protocol build && pnpm --filter @ohmaseclaro/atrium-react build && tsc -p server/tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ohmaseclaro/atrium-protocol": "workspace:*",
    "@ohmaseclaro/atrium-react": "workspace:*",
    "@ohmaseclaro/atrium-server": "workspace:*",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "wait-on": "^8.0.1"
  }
}

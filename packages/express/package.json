{
  "name": "@atriumjs/express",
  "version": "0.3.0",
  "description": "Express-compatible middleware for Atrium remote browser sessions (API dials workers)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohmaseclaro/atrium.git",
    "directory": "packages/express"
  },
  "bugs": {
    "url": "https://github.com/ohmaseclaro/atrium/issues"
  },
  "homepage": "https://github.com/ohmaseclaro/atrium/tree/main/packages/express#readme",
  "keywords": [
    "atrium",
    "remote-browser",
    "express",
    "browser-automation",
    "websocket",
    "playwright"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@atriumjs/core": "workspace:*",
    "@atriumjs/protocol": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "express": "^4.21.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "express": "^4.18.0"
  }
}

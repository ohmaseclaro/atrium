{
  "name": "@atriumjs/protocol",
  "version": "0.2.0",
  "description": "Shared wire types and validation for Atrium remote browser sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohmaseclaro/atrium.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/ohmaseclaro/atrium/issues"
  },
  "homepage": "https://github.com/ohmaseclaro/atrium/tree/main/packages/protocol#readme",
  "keywords": [
    "atrium",
    "remote-browser",
    "browser-automation",
    "websocket",
    "zod",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}

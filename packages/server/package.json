{
  "name": "@atrium/server",
  "version": "0.1.0",
  "description": "Express-compatible middleware for Atrium remote browser sessions (API dials workers)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],

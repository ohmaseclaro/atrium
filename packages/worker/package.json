{
  "name": "@atrium/worker",
  "version": "0.1.0",
  "description": "Playwright-based browser worker with inbound WebSocket backplane (API dials in)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/run.js",
    "start:xvfb": "xvfb-run -a --server-args='-screen 0 1920x1080x24 -ac' node dist/run.js"
  },
  "dependencies": {
    "@atrium/protocol": "workspace:*",
    "playwright": "^1.49.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}

{
  "name": "@atriumjs/worker",
  "version": "0.2.0",
  "description": "Playwright-based browser worker with inbound WebSocket backplane (API dials in)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohmaseclaro/atrium.git",
    "directory": "packages/worker"
  },
  "bugs": {
    "url": "https://github.com/ohmaseclaro/atrium/issues"
  },
  "homepage": "https://github.com/ohmaseclaro/atrium/tree/main/packages/worker#readme",
  "keywords": [
    "atrium",
    "remote-browser",
    "chromium",
    "playwright",
    "websocket",
    "browser-automation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "atrium-worker": "./dist/run.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "pnpm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/run.js",
    "start:xvfb": "xvfb-run -a --server-args='-screen 0 1920x1080x24 -ac' node dist/run.js"
  },
  "dependencies": {
    "@atriumjs/protocol": "workspace:*",
    "playwright": "^1.49.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
